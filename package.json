  },
  "devDependencies": {
    "@types/node": "18.11.10",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.0.0"
  }
